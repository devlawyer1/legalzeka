FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV NODE_ENV=test

COPY package*.json ./
RUN npm ci

COPY server.js ./
COPY src ./src
COPY test ./test
RUN mkdir -p uploads

CMD ["npm", "test"]
