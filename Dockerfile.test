FROM node:22-bookworm-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV NODE_ENV=test

COPY package*.json ./
RUN npm ci

COPY server.js ./
COPY src ./src
COPY test ./test
COPY docs ./docs
COPY .github ./.github
COPY docker-compose.yml docker-compose.staging.yml docker-compose.production.yml ./
RUN mkdir -p uploads

CMD ["npm", "test"]
