# Server
PORT=3000
NODE_ENV=development

# PostgreSQL / pgvector
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/emsal_atlasi
# Docker services use this value when set. Use it for AWS RDS or another remote PostgreSQL.
# Example: postgresql://username:password@your-rds-endpoint.region.rds.amazonaws.com:5432/emsal_atlasi?sslmode=require
DOCKER_DATABASE_URL=

# Tests must use a dedicated database whose name contains "test".
TEST_DATABASE_URL=postgresql://postgres:postgrespassword@localhost:55432/legalzeka_test

# Private local document storage. Files are served only through authorized API routes.
LOCAL_UPLOAD_DIR=uploads
DOCUMENT_MAX_FILE_SIZE_BYTES=52428800
DOCUMENT_MAX_EXTRACTED_TEXT_CHARS=2000000
FILE_SCANNER_PROVIDER=noop
# Set true in production after configuring a real scanner provider.
FILE_SCANNER_REQUIRED=false

# PostgreSQL-backed document processing worker
DOCUMENT_WORKER_CONCURRENCY=2
DOCUMENT_JOB_MAX_ATTEMPTS=3
DOCUMENT_JOB_TIMEOUT_MS=120000
DOCUMENT_JOB_STALE_AFTER_MS=300000
DOCUMENT_JOB_POLL_INTERVAL_MS=1000
DOCUMENT_JOB_BACKOFF_MS=30000,120000,600000

# Phase 1C page OCR and structured extraction
OCR_PROVIDER=tesseract
OCR_LANGUAGE=tur
# Optional local directory containing tur.traineddata.gz. No English fallback is used.
TESSERACT_LANG_PATH=
OCR_MIN_CONFIDENCE=0.65
OCR_NATIVE_TEXT_MIN_CHARS=40
OCR_PDF_RENDER_SCALE=1.7
DOCUMENT_MAX_PAGE_TEXT_CHARS=250000
EXTRACTION_VERSION=1
EXTRACTION_MAX_MODEL_CALLS=2
EXTRACTION_MAX_CONTEXT_CHARS=60000
EXTRACTION_MAX_PAGE_CHARS=12000
EXTRACTION_INPUT_COST_PER_MILLION=0
EXTRACTION_OUTPUT_COST_PER_MILLION=0

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Elasticsearch
ELASTICSEARCH_NODE=http://localhost:9200

# Yargi MCP - use LegalZeka self-hosted service, not public upstream runtime.
YARGI_MCP_URL=http://localhost:8000
YARGI_MCP_ALLOW_REMOTE=false
YARGI_MCP_BLOCKED_HOSTS=yargimcp.surucu.dev,yargimcp.fastmcp.app,yargi-mcp-pro-production.up.railway.app,yargi.betaspacestudio.com
YARGI_MCP_TIMEOUT_MS=45000
YARGI_MCP_RETRIES=3
YARGI_MCP_CACHE_TTL_MS=86400000
YARGI_MCP_CACHE_MAX=1000
YARGI_MCP_CONCURRENCY=8
YARGI_MCP_CIRCUIT_FAILURES=5
YARGI_MCP_CIRCUIT_COOLDOWN_MS=60000
EMSAL_LIVE_MCP=true
EMSAL_MCP_SOURCE_TIMEOUT_MS=16000
EMSAL_MCP_VERIFY_LIMIT=8
EMSAL_LOCAL_VECTOR_ENABLED=false

# Legal corpus cache filled by services/legal-data-worker
LEGAL_CORPUS_ENABLED=true
LEGAL_CORPUS_SEMANTIC_ENABLED=false
LEGAL_CORPUS_EMBEDDING_URL=http://embedding:80
EMBEDDING_PROVIDER=tei
EMBEDDING_MODEL=intfloat/multilingual-e5-large
EMBEDDING_COST_PER_1K_TOKENS=0
LEGAL_SEARCH_CACHE_MAX=500
LEGAL_SEARCH_CACHE_TTL_MS=300000

# Phase 2B grounded legal research
LEGAL_RESEARCH_SEARCH_LIMIT=20
LEGAL_RESEARCH_SUPPORT_SOURCE_LIMIT=8
LEGAL_RESEARCH_COUNTER_SOURCE_LIMIT=4
LEGAL_RESEARCH_LLM_MAX_ATTEMPTS=2
LEGAL_RESEARCH_MAX_OUTPUT_TOKENS=2200
LEGAL_RESEARCH_INPUT_COST_PER_MILLION=0
LEGAL_RESEARCH_OUTPUT_COST_PER_MILLION=0
LEGAL_RESEARCH_RATE_LIMIT_WINDOW_MS=60000
LEGAL_RESEARCH_RATE_LIMIT_MAX=12

# Data worker defaults
EMBEDDING_BASE_URL=http://embedding:80
EMBEDDING_ENABLED=false
BEDESTEN_PHRASE=karar
MEVZUAT_MODE=all
MEVZUAT_PAGE_SIZE=50
MEVZUAT_MAX_RECORDS=0
REQUEST_DELAY_MS=1500
REQUEST_DELAY_JITTER_MS=1000
BEDESTEN_PAGE_COOLDOWN_MS=10000
BEDESTEN_429_SLEEP_MS=90000
MAX_PAGES_PER_RUN=1

# LLM Provider (ollama | gemini | openai | claude | bedrock)
LLM_PROVIDER=bedrock
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=emsal_atlasi

# AWS Bedrock
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# UYAP RPA Configuration
UYAP_PORTAL_URL=https://avukat.uyap.gov.tr
UYAP_BROWSER_TIMEOUT=30000
UYAP_MAX_RETRIES=3
