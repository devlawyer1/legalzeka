{
  "name": "emsal-atlasi",
  "version": "1.0.0",
  "description": "Emsal Atlası - LegalTech SaaS Backend API",
  "main": "server.js",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/utils/seedDatabase.js && node src/utils/seedLaws.js",
    "migrate": "node src/utils/migrate.js up",
    "migrate:status": "node src/utils/migrate.js status",
    "migrate:preflight": "node src/utils/migrate.js preflight",
    "migrate:dry-run": "node src/utils/migrate.js dry-run",
    "migrate:verify": "node src/utils/migrate.js verify",
    "optimize": "node src/utils/optimizeDb.js",
    "seed:vector": "node src/utils/seedDatabase.js",
    "seed:laws": "node src/utils/seedLaws.js",
    "smoke:yargi": "node src/scripts/smoke_yargi_mcp.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test test/unit/*.test.js",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.js",
    "test:e2e": "node --test test/e2e/*.test.js",
    "worker:documents": "node src/workers/documentWorker.js",
    "worker:agents": "node src/workers/agentWorker.js",
    "worker:notifications": "node src/workers/notificationWorker.js",
    "worker:scheduler": "node src/workers/schedulerWorker.js",
    "smoke:production-like": "node src/scripts/productionLikeSmoke.js",
    "storage:migrate:s3": "node src/scripts/migrateLocalStorageToS3.js"
  },
  "keywords": [
    "legaltech",
    "saas",
    "emsal",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1048.0",
    "@aws-sdk/client-s3": "^3.1077.0",
    "@aws-sdk/lib-storage": "^3.1077.0",
    "@aws-sdk/s3-request-presigner": "^3.1077.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.16.1",
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "docx": "^9.5.1",
    "dotenv": "^16.4.7",
    "eventsource": "^4.1.0",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lru-cache": "^11.5.0",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "pg": "^8.11.3",
    "puppeteer": "^25.0.4",
    "redis": "^6.0.1",
    "tesseract.js": "^7.0.0",
    "uuid": "^11.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "overrides": {
    "dompurify": "^3.4.11",
    "form-data": "^4.0.6",
    "hono": "^4.12.27",
    "js-yaml": "^4.3.0",
    "next": {
      "postcss": "^8.5.10"
    },
    "postcss": "^8.5.10",
    "qs": "^6.15.3",
    "undici": "^7.28.0",
    "ws": "^8.21.0"
  }
}
